# VX Environment Variables Configuration
# Copy this file to .env.local for local development. Never commit secrets to Git.

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Frontend-safe (Public Anon Key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend-only (Service Role / Secret Key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ==============================================================================
# Brevo (Sendinblue) Transactional Email Configuration (Server-Side Only)
# ==============================================================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@vx.dev
BREVO_SENDER_NAME=VX

# ==============================================================================
# AI Model Providers (Server-Side Only)
# ==============================================================================
# Google Gemini API
GEMINI_API_KEY=

# OpenRouter API (Access to Claude, GPT-4o, DeepSeek, Llama, Mistral)
OPENROUTER_API_KEY=

# ==============================================================================
# Auth Security Secrets
# ==============================================================================
AUTH_SECRET=
VERIFICATION_HASH_SECRET=

# ==============================================================================
# GitHub Integration (Server-Side Only)
# ==============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ==============================================================================
# Vercel Deployment Integration (Server-Side Only)
# ==============================================================================
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=
